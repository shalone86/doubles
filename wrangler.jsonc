{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doubles",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  // Lives at angelio.org through the hub. The old address redirects there with saved progress (worker/moved.js).
  "vars": { "HOME_URL": "https://angelio.org/doubles/", "STORE_KEY": "doubles:v1" },
  "workers_dev": true,
  "routes": [{ "pattern": "doubles.shalonely.com", "custom_domain": true }]
}
